# Money Pull Up — Expo web/app environment.
# Copy to `.env` and fill in. Every EXPO_PUBLIC_* value is inlined into the
# client bundle at build time, so it must be present when you run
# `expo start`, `expo export`, or the CI web-deploy workflow.
# These are public client keys (not secrets); real secrets (Stripe secret key,
# service account) live in the Cloud Functions config / GitHub secrets instead.

# ─── Firebase (Project settings → General → Your apps → Web app config) ───
# Without these three (API key, project id, app id) the app runs with Firebase
# disabled: no auth, no Firestore, no callable functions.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=money-pull-up-5378b.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=money-pull-up-5378b
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=money-pull-up-5378b.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ─── Stripe (publishable key — starts with pk_test_ / pk_live_) ───
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Backend / links ───
# REST API base for wallet top-up checkout (lib/payments.ts).
EXPO_PUBLIC_API_URL=
# Public web origin used for share/return links.
EXPO_PUBLIC_WEB_URL=
# Legal document URLs shown on the fan profile.
EXPO_PUBLIC_CGU_URL=https://moneypullup.app/cgu
EXPO_PUBLIC_PRIVACY_URL=https://moneypullup.app/confidentialite
EXPO_PUBLIC_LEGAL_URL=https://moneypullup.app/mentions-legales
